# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blog?retryWrites=true&w=majority

# Google OAuth "Web application" client id (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=

# Secret used to sign login sessions. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Emails that get the admin role (can edit/delete any post). Comma-separated.
ADMIN_EMAILS=

# Your deployed front-end URL (e.g. https://tech-blog.vercel.app). Leave empty for local dev.
CLIENT_ORIGIN=

# Local dev port (ignored on Vercel)
PORT=5001

# Only needed once, for `npm run migrate` (old MySQL database)
# MYSQL_URL=
